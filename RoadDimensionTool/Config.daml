  <modules>
    <insertModule id="RoadDimensionTool_Module" className="Module1" autoLoad="false" caption="Module1">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <!--<tab id="RoadDimensionTool_Tab1" caption="New Tab">
          <group refID="RoadDimensionTool_Group1"/>
        </tab>-->
      </tabs>
      <groups>
        <!-- comment this out if you have no controls on the Addin tab to avoid
              an empty group-->
        <group id="RoadDimensionTool_Group1" caption="Group 1" appearsOnAddInTab="true">
          <!-- host controls within groups -->
          <tool refID="RoadDimensionTool_MapTool1" size="large" />
        </group>
      </groups>
      <controls>
        <!-- add your controls here -->
        <tool id="RoadDimensionTool_MapTool1" caption="MapTool 1" className="MapTool1" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </tool>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>