<ArcGIS defaultAssembly="RoadDimensionTool.dll" defaultNamespace="RoadDimensionTool" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{79d7f73e-5a54-4572-aee4-26a8ec1b1090}" version="1.0" desktopVersion="3.6.59527" product="ArcGISPro">
